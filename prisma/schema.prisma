generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LanguageCode {
  HY
  EN
  RU
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRANSLATE
  WORD_ORDER
  TYPE_ANSWER
}

enum XpSource {
  CORRECT_ANSWER
  LESSON_COMPLETE
  DAILY_GOAL
}

enum AchievementType {
  FIRST_LESSON
  LESSONS_COMPLETED
  STREAK_DAYS
  XP_TOTAL
  WORDS_LEARNED
}

enum SkillType {
  VOCABULARY
  GRAMMAR
  LISTENING
  READING
  TRANSLATION
}

enum ExerciseDifficulty {
  EASY
  MEDIUM
  HARD
}

enum KnowledgeState {
  NEW
  LEARNING
  WEAK
  LEARNED
  MASTERED
}

enum LessonKind {
  STANDARD
  REVIEW
  ASSESSMENT
}

enum TopicKind {
  VOCABULARY
  GRAMMAR
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  avatar       String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile        Profile?
  enrollments    UserCourseEnrollment[]
  vocabulary     UserVocabulary[]
  lessonProgress LessonProgress[]
  courseProgress UserProgress[]
  streak         UserStreak?
  xpEvents       UserXP[]
  answers        UserAnswer[]
  attempts       LessonAttempt[]
  dailyGoals          DailyGoal[]
  achievements        UserAchievement[]
  topicMasteries      TopicMastery[]
  skillMasteries      SkillMastery[]
  levelMasteries      LevelMastery[]
  assessmentAttempts  AssessmentAttempt[]
  reviewItems         ReviewItem[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model AppSettings {
  id        String   @id @default("default")
  heartsMax Int      @default(5)
  updatedAt DateTime @updatedAt
}

model Profile {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  nativeLanguage  LanguageCode @default(HY)
  uiLocale        LanguageCode @default(HY)
  level           Int          @default(1)
  hearts          Int          @default(5)
  heartsRefilledAt DateTime    @default(now())
  dailyGoalXp     Int          @default(50)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Course {
  id             String       @id @default(cuid())
  slug           String       @unique
  sourceLanguage LanguageCode
  targetLanguage LanguageCode
  title          String
  description    String
  isPublished    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  units        Unit[]
  enrollments         UserCourseEnrollment[]
  progress            UserProgress[]
  vocabulary          VocabularyWord[]
  topicMasteries      TopicMastery[]
  skillMasteries      SkillMastery[]
  levelMasteries      LevelMastery[]
  assessmentAttempts  AssessmentAttempt[]
  reviewItems         ReviewItem[]

  @@unique([sourceLanguage, targetLanguage])
  @@index([isPublished])
}

model UserCourseEnrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId, isActive])
}

model Unit {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  title       String
  description String
  order       Int
  level       String  @default("A1")
  lessons     Lesson[]

  @@unique([courseId, order])
  @@index([courseId, order])
}

model Lesson {
  id                String   @id @default(cuid())
  unitId            String
  unit              Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  title             String
  description       String
  order             Int
  xpReward          Int      @default(20)
  estimatedMinutes  Int        @default(6)
  kind              LessonKind @default(STANDARD)
  questions         Question[]
  vocabulary        LessonVocabulary[]
  topics            LessonTopic[]
  progress          LessonProgress[]
  attempts          LessonAttempt[]
  assessments       AssessmentAttempt[]

  @@unique([unitId, order])
  @@index([unitId, order])
  @@index([kind])
}

model Question {
  id              String       @id @default(cuid())
  lessonId        String
  lesson          Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type            QuestionType
  prompt          String
  explanation     String?
  order           Int
  acceptedAnswers String[]
  payload         Json?
  skillType       SkillType           @default(VOCABULARY)
  difficulty      ExerciseDifficulty  @default(MEDIUM)
  topicId         String?
  topic           Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  options         QuestionOption[]
  answers         UserAnswer[]
  reviews         ReviewItem[]

  @@unique([lessonId, order])
  @@index([lessonId, order])
  @@index([topicId])
  @@index([skillType, difficulty])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@index([questionId])
}

model VocabularyWord {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  sourceText      String
  targetText      String
  pronunciation   String
  exampleSentence String
  difficulty      Int      @default(1)
  lessons         LessonVocabulary[]
  learners        UserVocabulary[]

  @@index([courseId])
}

model LessonVocabulary {
  lessonId         String
  lesson           Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  vocabularyWordId String
  vocabularyWord   VocabularyWord @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)

  @@id([lessonId, vocabularyWordId])
}

model UserVocabulary {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyWordId String
  vocabularyWord   VocabularyWord  @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)
  mastery          Int             @default(0)
  correctAnswers   Int             @default(0)
  incorrectAnswers Int             @default(0)
  lastReviewedAt   DateTime?
  nextReviewAt     DateTime?
  knowledgeState   KnowledgeState @default(NEW)
  intervalDays     Int            @default(0)
  repetitions      Int            @default(0)
  easeFactor       Float          @default(2.5)

  @@unique([userId, vocabularyWordId])
  @@index([userId, mastery])
  @@index([userId, nextReviewAt])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  completed   Boolean   @default(false)
  score       Int       @default(0)
  attempts    Int       @default(0)
  completedAt DateTime?

  @@unique([userId, lessonId])
  @@index([userId, completed])
}

model UserProgress {
  id                    String  @id @default(cuid())
  userId                String
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId              String
  course                Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  currentUnitId         String?
  currentLessonId       String?
  startLevel            String  @default("A1")
  totalLessonsCompleted Int     @default(0)
  totalWordsLearned     Int     @default(0)

  @@unique([userId, courseId])
}

model UserStreak {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
}

model UserXP {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  source    XpSource
  sourceId  String?
  createdAt DateTime  @default(now())

  @@unique([userId, source, sourceId])
  @@index([userId, createdAt])
}

model LessonAttempt {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  questionIds  String[]
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  score        Int?
  xpAwarded    Int       @default(0)

  answers UserAnswer[]

  @@index([userId, lessonId, startedAt])
}

model UserAnswer {
  id         String        @id @default(cuid())
  attemptId  String
  attempt    LessonAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question      @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answer        String
  isCorrect     Boolean
  createdAt     DateTime             @default(now())
  timeSpentMs   Int?
  attemptNumber Int                  @default(1)
  skillType     SkillType?
  topicId       String?
  unitId        String?
  levelKey      String?

  @@unique([attemptId, questionId])
  @@index([userId, createdAt])
  @@index([userId, topicId, createdAt])
  @@index([userId, skillType, createdAt])
  @@index([userId, levelKey, createdAt])
}

model DailyGoal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  targetXP  Int
  currentXP Int      @default(0)

  @@unique([userId, date])
}

model Achievement {
  id          String          @id @default(cuid())
  type        AchievementType
  name        String
  description String
  icon        String
  threshold   Int
  users       UserAchievement[]

  @@unique([type, threshold])
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model Topic {
  id         String    @id @default(cuid())
  key        String
  kind       TopicKind
  level      String
  title      String
  isCritical Boolean   @default(false)
  createdAt  DateTime  @default(now())

  questions  Question[]
  lessons    LessonTopic[]
  masteries  TopicMastery[]
  reviews    ReviewItem[]

  @@unique([key, level])
  @@index([level, kind])
}

model LessonTopic {
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topicId  String
  topic    Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([lessonId, topicId])
  @@index([topicId])
}

model TopicMastery {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  topicId             String
  topic               Topic          @relation(fields: [topicId], references: [id], onDelete: Restrict)
  score               Float          @default(0)
  evidenceScore       Float          @default(50)
  knowledgeState      KnowledgeState @default(NEW)
  correctCount        Int            @default(0)
  incorrectCount      Int            @default(0)
  consecutiveCorrect  Int            @default(0)
  consecutiveWrong    Int            @default(0)
  lastResultCorrect   Boolean?
  lastPracticedAt     DateTime?
  nextReviewAt        DateTime?
  intervalIndex       Int            @default(0)
  easeFactor          Float          @default(2.5)
  updatedAt           DateTime       @updatedAt

  @@unique([userId, courseId, topicId])
  @@index([userId, courseId])
  @@index([userId, nextReviewAt])
  @@index([userId, courseId, score])
}

model SkillMastery {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  levelKey    String
  skillType   SkillType
  score       Float     @default(0)
  sampleCount Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([userId, courseId, levelKey, skillType])
  @@index([userId, courseId, levelKey])
}

model LevelMastery {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId              String
  course                Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  levelKey              String
  overallScore          Float     @default(0)
  lessonsCompleted      Int       @default(0)
  lessonsTotal          Int       @default(0)
  isUnlocked            Boolean   @default(false)
  unlockedAt            DateTime?
  lastAssessmentScore   Int?
  lastAssessmentPassed  Boolean?
  updatedAt             DateTime  @updatedAt

  @@unique([userId, courseId, levelKey])
  @@index([userId, courseId])
}

model AssessmentAttempt {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  levelKey     String
  lessonId     String?
  lesson       Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  attemptId    String?
  score        Int
  passed       Boolean
  questionIds  String[]
  createdAt    DateTime  @default(now())

  @@index([userId, courseId, levelKey, createdAt])
}

model ReviewItem {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  topicId          String?
  topic            Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  vocabularyWordId String?
  questionId       String?
  question         Question?      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  knowledgeState   KnowledgeState @default(LEARNING)
  intervalIndex    Int            @default(0)
  nextReviewAt     DateTime
  lastReviewedAt   DateTime?
  lastCorrect      Boolean?
  createdAt        DateTime       @default(now())

  @@unique([userId, courseId, questionId])
  @@index([userId, courseId, nextReviewAt])
  @@index([userId, topicId])
}
